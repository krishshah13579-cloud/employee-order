{
  "name": "garment-order-manager",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-sync.js && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:use-postgres": "node scripts/switch-db.js postgresql && prisma generate",
    "db:use-sqlite": "node scripts/switch-db.js sqlite && prisma generate",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "auto-push": "node scripts/auto-git-push.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "nodemailer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
