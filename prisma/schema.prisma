generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin Authentication & 2FA Credentials Stored in Database
model AdminAccount {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  password         String
  twoFactorSecret  String    @default("") // 2FA secret stored in DB
  twoFactorEnabled Boolean   @default(true)
  lastOtp          String?   // Latest generated 2FA OTP stored in DB
  otpExpiresAt     DateTime?
  updatedAt        DateTime  @updatedAt
}

// 1. Admin Page (Admin Details)
model AdminProfile {
  id          Int      @id @default(autoincrement())
  fullName    String   @default("Administrator")
  email       String   @default("")
  phone       String   @default("+91 98250 13579")
  companyName String   @default("IQ TROUSERS")
  gstNo       String   @default("24AAACI1357Q1Z2")
  panNo       String   @default("AAACI1357Q")
  address     String   @default("Plot 501-504, Textile Tower, Ring Road, Surat, Gujarat - 395002")
  bankName    String   @default("HDFC Bank Ltd")
  accountNo   String   @default("50200098765432")
  ifscCode    String   @default("HDFC0001357")
  notes       String?  @default("IQ TROUSERS — Premium Quality Mens & Boys Garment Manufacturers")
  updatedAt   DateTime @updatedAt
}

// 2. Employee Page (Employee Details: Name, Email, PIN, Mobile Number, Address, Proof (Upload))
model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?  // Staff Email Address
  pin          String   @default("1234") // Secret PIN for employee portal login
  mobileNumber String
  address      String
  proofUrl     String?  // Photo or document link (Aadhar / PAN / Driving License)
  designation  String   @default("Sales Representative")
  isTeamLeader Boolean  @default(false) // T.L. has unrestricted 24*7 access to employee panel
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 3. Customer Page (Customer Details: Shop Name / Firm Name, GST No./PAN No., Address, City, State, Phone Number, Visiting Card (Photo/Upload))
model Customer {
  id              Int      @id @default(autoincrement())
  shopName        String   // Firm Name / Shop Name
  gstPanNo        String   // GST No. / PAN No.
  businessType    String   @default("RETAILER") // RETAILER or WHOLESALER
  creditDays      Int      @default(0) // Credit payment days (Super Admin only can edit)
  specialDiscount Float    @default(0) // Special discount per piece for RETAILER WITH SPECIAL DISCOUNT
  address         String   // Shop Address
  city            String?  // City
  state           String?  // State
  phoneNumber     String   // Phone Number
  visitingCardUrl String?  // Visiting Card (Photo/Upload)
  contactPerson   String?  // Primary Contact Person Name
  contactPersons  String?  // JSON Array of Multiple Contact Persons [{name, phone, designation}]
  allocatedEmployeeId   Int?     // Assigned employee id
  allocatedEmployeeName String?  // Assigned employee name
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
  payments        Payment[]
  salesReturns    SalesReturn[]
  salesInvoices   SalesInvoice[]
}

// 5. Product Page (Product Details: Product Name, Colors Available, Sizes, Price, No of Set Colorwise, Size Guide)
model Product {
  id              Int         @id @default(autoincrement())
  name            String
  category        String      @default("Formal & Casual Trousers")
  colorsAvailable String      // Comma-separated list: "Dark Grey, Navy Blue, Jet Black, Khaki"
  colorMapping    String?     // Admin Color Alphabet Mapping JSON: {"A": "Dark Grey", "B": "Navy Blue"}
  sizesRatio      String      @default("30 to 38") // e.g., "28 to 36", "30 to 38", "28 to 40"
  sizesList       String      @default("30, 32, 34, 36, 38") // Mandatory sizes in 1 set
  pcsPerSet       Int         @default(5) // Number of pcs in one set
  mrp             Float?      // Maximum Retail Price
  retailerPrice   Float?      // Retailer Selling Price: MRP / 2
  wholesalerPrice Float?      // Wholesaler Selling Price: MRP / 2 - 100
  price           Float       @default(490) // Base / Retailer Price per PC
  costPrice       Float?      // Costing price per PC (e.g. fabric + tailoring + packaging)
  mixPcs          Int         @default(0) // Mixed / loose single pieces in stock
  colorImages     String?     // JSON mapping of color -> photo data URL or image index
  setsColorwise   String?     // Stock/Default Sets colorwise, supporting multi-ratio sets
  sizeGuide       String?     // Size guide instructions / dimensions / image link
  imageUrl        String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

// 4. Order Page (Order Details: Customer Name, Customer GST/PAN No., Order Date, Product Name (Colors), SET (Color Wise) like A-2, B-3, C-2, SIZES (all size mandatory) like 30 to 38, PCS = SET * PCS like if there are 5 set for the product and the sizes are 30 to 38 it would be like 5*5 = 25 PCS, Price, Total Price, at last add 5% GST)
model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  customerId      Int
  customerName    String      // Shop Name or Customer Name
  customerGstPan  String      // GST/PAN No
  customerPhone   String?
  customerAddress String?
  businessType    String?     // Customer Type: RETAILER or WHOLESALER
  creditDays      Int         @default(0) // Credit payment days granted for this order
  orderDate       DateTime    @default(now())
  status          String      @default("Pending") // Pending, Confirmed, In Production, Ready, Dispatched, Delivered, Cancelled
  subtotal        Float       @default(0) // Total Price before GST
  gstRate         Float       @default(5.0) // 5% GST
  gstAmount       Float       @default(0) // Subtotal * 0.05
  grandTotal      Float       @default(0) // Subtotal + gstAmount
  totalPcs        Int         @default(0) // Total Pieces
  totalSets       Int         @default(0) // Total Sets
  placedBy         String?     // Booked by employee/admin
  taxInvoiceNumber String?     // Set by admin once order is ready (e.g. TI-2026-001)
  taxInvoiceDate   DateTime?   // Tax Invoice date set by admin
  taxInvoiceItems  String?     // JSON string of updated items with modified quantities/amounts for tax invoice
  templateOverrides String?    // JSON string of order-specific template overrides (e.g. customized company name, terms, bank details)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  customer         Customer    @relation(fields: [customerId], references: [id])
  items            OrderItem[]
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  productName  String
  colorSets    String  // JSON string: [{"color": "Dark Grey", "sets": 2}, {"color": "Navy Blue", "sets": 3}]
  sizeRatio    String  // e.g. "30 to 38"
  sizesList    String  // e.g. "30, 32, 34, 36, 38"
  pcsPerSet    Int     // e.g. 5
  totalSets    Int     // e.g. 5
  totalPcs     Int     // e.g. 5 * 5 = 25
  unitPrice    Float   // Price per piece
  itemSubtotal Float   // totalPcs * unitPrice
  notes        String?
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
}

// 6. Category Page (Organize products into custom categories and collections)
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 7. Payment Ledger (Track payments received from customers for outstanding settlement)
model Payment {
  id           Int      @id @default(autoincrement())
  customerId   Int
  customerName String
  amount       Float
  paymentDate  DateTime @default(now())
  paymentMode  String   @default("Bank Transfer") // Bank Transfer, Cash, UPI, Cheque, RTGS
  referenceNo  String?  // Cheque no, UTR, transaction ID
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// 8. Sales Return / Credit Note (Track product returns and credit against customer outstanding)
model SalesReturn {
  id           Int      @id @default(autoincrement())
  returnNumber String   @unique // e.g. RET-261016-001
  customerId   Int
  customerName String
  orderId      Int?     // Optional reference to original order
  orderNumber  String?
  returnDate   DateTime @default(now())
  totalAmount  Float    // Total credit amount to deduct from outstanding
  totalPcs     Int      @default(0)
  totalSets    Int      @default(0)
  items        String   // JSON: [{ productName, color, sizeRatio, sets, pcs, unitPrice, amount, reason }]
  reason       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// 9. Sales Register & Invoicing (Track all sales invoices, cash sales, and credit sales)
model SalesInvoice {
  id              Int       @id @default(autoincrement())
  invoiceNumber   String    @unique // e.g. INV-261017-001 or CS-261017-001
  orderId         Int?      // Linked order if originated from confirmed order
  orderNumber     String?   // Linked order number (e.g. GO-261017-001)
  customerId      Int?      // Optional: can be null for walk-in counter cash sales
  customerName    String    // Firm name or Cash Customer name
  customerPhone   String?
  customerGstPan  String?
  customerAddress String?
  businessType    String?   @default("RETAILER") // RETAILER, WHOLESALER, or CASH
  invoiceDate     DateTime  @default(now())
  paymentType     String    @default("Credit") // "Cash" or "Credit" (or "UPI", "Bank Transfer")
  paymentStatus   String    @default("Unpaid") // "Paid", "Partially Paid", "Unpaid"
  subtotal        Float     @default(0)
  gstRate         Float     @default(5.0)
  gstAmount       Float     @default(0)
  grandTotal      Float     @default(0)
  paidAmount      Float     @default(0) // Immediately equals grandTotal for cash sales
  balanceAmount   Float     @default(0) // Remaining unpaid balance
  totalSets       Int       @default(0)
  totalPcs        Int       @default(0)
  items           String    // JSON string of invoice items
  creditDays      Int       @default(0)
  notes           String?
  placedBy        String?   // Billed by admin/employee
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

// 9. Invoice & Order Form Template Settings
model InvoiceTemplate {
  id               Int      @id @default(autoincrement())
  companyName      String   @default("KRISH CLOTHING CO.")
  addressLine1     String   @default("2ND FLOOR, Q-8,SAMET BUSINESS PARK,NEAR PARISHKAR-2,KHOKHARA CIRCLE,MANINAGAR,")
  addressLine2     String   @default("AHMEDABAD - 380008 (M) : 8128756632")
  phone            String   @default("+91 8128756632")
  email            String   @default("krishclothingco3@gmail.com")
  gstNo            String   @default("24LAAPS9916E1ZD")
  panNo            String   @default("LAAPS9916E")
  placeOfSupply    String   @default("24-Gujarat")
  bankName         String   @default("ICICI BANK")
  accountNo        String   @default("750705000692")
  ifscCode         String   @default("ICIC0007507")
  beneficiaryName  String   @default("KRISH CLOTHING CO.")
  branch           String   @default("Khokhra Maninagar, Ahmedabad")
  terms1           String   @default("1. Goods once sold will not be taken back.")
  terms2           String   @default("2. Interest @18% p.a. will be charged if payment is not made within due date.")
  terms3           String   @default("3. Our risk and responsibility ceases as soon as the goods leave our premises.")
  terms4           String   @default("4. \"Subject to 'AHMEDABAD' Jurisdiction only. E.&.O.E\"")
  terms5           String   @default("5. Any damages or problem in any products should be informed within 7 days of purchase.")
  creditNotePrefix String   @default("PAYMENT EVERY WEEK AND SHOULD BE COMPLETED WITHIN")
  signatoryLabel   String   @default("For, KRISH CLOTHING CO.")
  signatoryTitle   String   @default("(Authorised Signatory)")
  defaultTransport String   @default("Patel Transport Co.")
  defaultHsn       String   @default("6203")
  updatedAt        DateTime @updatedAt
}

// 10. Security & Compliance Audit Log
model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   // e.g. "AUTH_LOGIN", "AUTH_2FA_SUCCESS", "AUTH_2FA_FAIL", "ORDER_STATUS_UPDATE", "CUSTOMER_UPDATE"
  actorType  String   // "ADMIN", "EMPLOYEE", "SYSTEM"
  actorName  String   // username or employee name
  entityType String?  // "Order", "Customer", "Product", "AdminAccount", etc.
  entityId   String?  // ID of affected entity
  details    String?  // Description or JSON summary
  ipAddress  String?  // Client IP address
  status     String   @default("SUCCESS") // "SUCCESS", "FAILURE", "BLOCKED"
  createdAt  DateTime @default(now())
}

// 11. Live Real-Time Stock Reservations (Prevents over-allocation when multiple employees add sets)
model StockReservation {
  id           Int      @id @default(autoincrement())
  sessionId    String   // Unique browser/employee session ID
  employeeName String?  // Name of the employee holding the reservation
  productId    Int
  color        String   // Color name, e.g. "Black", "Navy Blue"
  sets         Int      @default(0) // Reserved number of sets
  expiresAt    DateTime // Reservation expiry timestamp (TTL: e.g. 15 minutes)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, color])
  @@index([sessionId])
  @@index([expiresAt])
}

// 12. Visited Customer (Field Visiting Cards with Mandatory UPPERCASE City)
model VisitedCustomer {
  id              Int      @id @default(autoincrement())
  visitingCardUrl String   // Visiting Card (Photo / Upload / Data URL)
  city            String   // City name in CAPITAL ONLY (e.g. "SURAT", "AHMEDABAD")
  shopName        String?  // Optional Shop Name / Firm Name
  phone           String?  // Optional Contact Number
  contactPerson   String?  // Optional Contact Person Name
  notes           String?  // Optional Visit / Discussion Notes
  employeeId      Int?     // Employee ID who visited
  employeeName    String?  // Employee Name who visited
  status          String   @default("Visited") // Visited, Follow Up, Converted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([employeeId])
  @@index([createdAt])
}

